{
  "name": "recall-ai",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "supabase": "supabase",
    "backup:local": "node scripts/local-backup.mjs",
    "backup:verify": "node scripts/verify-local-backup.mjs",
    "worker:dev": "pnpm --filter @recall/worker dev",
    "worker:start": "pnpm --filter @recall/worker start"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@supabase/supabase-js": "2.111.0",
    "jsdom": "^27.0.0",
    "supabase": "^2.110.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
